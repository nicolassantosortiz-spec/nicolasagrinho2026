<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jogo: Guardião do Solo</title>
    <style>
        :root {
            --primary: #4a7c59;
            --secondary: #8b5a2b;
            --light: #f4f1de;
            --danger: #e07a5f;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--light);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        #game-container {
            background: white;
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            max-width: 600px;
            width: 90%;
            text-align: center;
        }

        h1 { color: var(--primary); }
        
        .stats {
            display: flex;
            justify-content: space-around;
            margin-bottom: 20px;
            font-weight: bold;
        }

        #question-text {
            font-size: 1.2rem;
            margin-bottom: 20px;
            color: #333;
        }

        .options-grid {
            display: grid;
            gap: 10px;
        }

        button {
            padding: 12px;
            border: none;
            border-radius: 8px;
            background-color: var(--primary);
            color: white;
            cursor: pointer;
            font-size: 1rem;
            transition: transform 0.1s, background 0.3s;
        }

        button:hover { background-color: #3a6347; }
        button:active { transform: scale(0.98); }

        #feedback {
            margin-top: 20px;
            font-weight: bold;
            min-height: 24px;
        }

        .hidden { display: none; }
    </style>
</head>
<body>

<div id="game-container">
    <h1>🌱 Guardião do Solo</h1>
    
    <div id="game-screen">
        <div class="stats">
            <span>Saúde do Solo: <span id="health">100</span>%</span>
            <span>Pontos: <span id="score">0</span></span>
        </div>
        
        <p id="question-text">Carregando desafio...</p>
        
        <div class="options-grid" id="options-container">
            </div>
        
        <p id="feedback"></p>
    </div>

    <div id="end-screen" class="hidden">
        <h2>Fim de Jogo!</h2>
        <p id="final-result"></p>
        <button onclick="location.reload()">Jogar Novamente</button>
    </div>
</div>

<script>
    const questions = [
        {
            q: "Sua plantação está em um terreno inclinado. Como evitar a erosão pela chuva?",
            options: [
                { text: "Plantar em Curvas de Nível", correct: true, feedback: "Correto! Isso reduz a velocidade da água." },
                { text: "Remover toda a vegetação", correct: false, feedback: "Errado! Solo exposto sofre erosão rápida." }
            ]
        },
        {
            q: "O solo está ficando compactado e sem nutrientes. O que fazer?",
            options: [
                { text: "Usar máquinas pesadas todo dia", correct: false, feedback: "Isso compacta o solo ainda mais!" },
                { text: "Fazer Rotação de Culturas", correct: true, feedback: "Ótimo! Diferentes plantas repõem nutrientes variados." }
            ]
        },
        {
            q: "Como proteger o solo contra o impacto direto da chuva e do sol forte?",
            options: [
                { text: "Manter a Cobertura Morta (palhada)", correct: true, feedback: "Exato! A palha protege e mantém a umidade." },
                { text: "Queimar os restos vegetais", correct: false, feedback: "A queimada mata os microrganismos benéficos." }
            ]
        },
        {
            q: "Sua terra está perdendo biodiversidade. Qual a melhor solução?",
            options: [
                { text: "Uso excessivo de fertilizantes químicos", correct: false, feedback: "Isso pode desequilibrar o pH e matar a vida no solo." },
                { text: "Adubação Orgânica", correct: true, feedback: "Perfeito! O húmus melhora a estrutura do solo." }
            ]
        }
    ];

    let currentQuestion = 0;
    let score = 0;
    let health = 100;

    const questionEl = document.getElementById('question-text');
    const optionsEl = document.getElementById('options-container');
    const feedbackEl = document.getElementById('feedback');
    const healthEl = document.getElementById('health');
    const scoreEl = document.getElementById('score');

    function loadQuestion() {
        if (currentQuestion >= questions.length || health <= 0) {
            showEndScreen();
            return;
        }

        const q = questions[currentQuestion];
        questionEl.innerText = q.q;
        optionsEl.innerHTML = '';
        feedbackEl.innerText = '';

        q.options.forEach(opt => {
            const btn = document.createElement('button');
            btn.innerText = opt.text;
            btn.onclick = () => checkAnswer(opt);
            optionsEl.appendChild(btn);
        });
    }

    function checkAnswer(option) {
        if (option.correct) {
            score += 25;
            feedbackEl.style.color = "green";
        } else {
            health -= 25;
            feedbackEl.style.color = "red";
        }
        
        feedbackEl.innerText = option.feedback;
        scoreEl.innerText = score;
        healthEl.innerText = health;

        currentQuestion++;
        setTimeout(loadQuestion, 2000);
    }

    function showEndScreen() {
        document.getElementById('game-screen').classList.add('hidden');
        const endScreen = document.getElementById('end-screen');
        endScreen.classList.remove('hidden');
        
        const message = health > 0 
            ? `Parabéns! Você conservou o solo com ${health}% de saúde.` 
            : "O solo foi totalmente degradado. Tente técnicas de conservação na próxima!";
        
        document.getElementById('final-result').innerText = message;
    }

    loadQuestion();
</script>

</body>
</html>
